# Copy to .env. This file contains examples, not working credentials.
# Values are literal KEY=VALUE entries; shell commands and variable expansion are not supported.
LEDGER_DATABASE_URL=postgresql://ledger_app:CHANGE_ME@127.0.0.1:5432/blockchain_ledger

# Local development only. For HTTPS deployment use the settings below.
LEDGER_BIND=127.0.0.1
LEDGER_PORT=8000
LEDGER_ALLOWED_HOSTS=localhost,127.0.0.1
LEDGER_PUBLIC_ORIGIN=http://127.0.0.1:8000
LEDGER_DEV_MODE=true
LEDGER_SECURE_COOKIES=false

# Set these only for the explicit --init-admin command, then remove the password.
# Normal startup must not create or overwrite an administrator automatically.
LEDGER_ADMIN_USERNAME=
LEDGER_ADMIN_PASSWORD=

# HTTPS example: replace every path/hostname with your actual values.
# LEDGER_BIND=0.0.0.0
# LEDGER_PORT=8443
# LEDGER_ALLOWED_HOSTS=ledger.example.com
# LEDGER_PUBLIC_ORIGIN=https://ledger.example.com:8443
# LEDGER_DEV_MODE=false
# LEDGER_SECURE_COOKIES=true
# LEDGER_TLS_CERT=/etc/blockchainLedger/fullchain.pem
# LEDGER_TLS_KEY=/etc/blockchainLedger/private.key
